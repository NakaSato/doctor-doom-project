{
  "dashboard": {
    "id": null,
    "uid": "doctor-doom-overview",
    "title": "Doctor Doom - System Overview",
    "tags": ["doctor-doom"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 0,
    "refresh": "10s",
    "panels": [
      {
        "id": 1,
        "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0},
        "type": "stat",
        "title": "Services Status",
        "targets": [
          {
            "expr": "up{job=~\"api-gateway|ml-inference|report|notify|geo|auth\"}",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ],
        "options": {
          "colorMode": "background",
          "graphMode": "none"
        }
      },
      {
        "id": 2,
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4},
        "type": "graph",
        "title": "Request Rate by Service",
        "targets": [
          {
            "expr": "rate(http_requests_total[5m])",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 3,
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4},
        "type": "graph",
        "title": "Response Time (p95)",
        "targets": [
          {
            "expr": "histogram_quantile(0.95, rate(http_request_duration_seconds_bucket[5m]))",
            "legendFormat": "{{job}}",
            "refId": "A"
          }
        ]
      },
      {
        "id": 4,
        "gridPos": {"h": 8, "w": 8, "x": 0, "y": 12},
        "type": "gauge",
        "title": "Redis Memory Usage",
        "targets": [
          {
            "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100",
            "legendFormat": "Memory %",
            "refId": "A"
          }
        ],
        "options": {
          "min": 0,
          "max": 100,
          "thresholds": [
            {"value": 0, "color": "green"},
            {"value": 70, "color": "yellow"},
            {"value": 90, "color": "red"}
          ]
        }
      },
      {
        "id": 5,
        "gridPos": {"h": 8, "w": 8, "x": 8, "y": 12},
        "type": "gauge",
        "title": "PostgreSQL Connections",
        "targets": [
          {
            "expr": "pg_stat_activity_count / pg_settings_max_connections * 100",
            "legendFormat": "Connection %",
            "refId": "A"
          }
        ],
        "options": {
          "min": 0,
          "max": 100,
          "thresholds": [
            {"value": 0, "color": "green"},
            {"value": 60, "color": "yellow"},
            {"value": 80, "color": "red"}
          ]
        }
      },
      {
        "id": 6,
        "gridPos": {"h": 8, "w": 8, "x": 16, "y": 12},
        "type": "graph",
        "title": "Redis Stream Length",
        "targets": [
          {
            "expr": "redis_stream_length",
            "legendFormat": "{{stream}}",
            "refId": "A"
          }
        ]
      }
    ]
  }
}
