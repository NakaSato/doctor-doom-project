    {
      "cell_type": "markdown",
      "source": [
        "## Step 4: Train Model"
      ],
      "metadata": {
        "id": "step4"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Training configuration\n",
        "EPOCHS = 100          # Number of training epochs\n",
        "BATCH_SIZE = 32       # Batch size (reduce if OOM)\n",
        "PROJECT = \"/content/drive/MyDrive/doctor-doom/models\"  # Save location\n",
        "NAME = \"stage1_colab\" # Experiment name\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"Starting Training\")\n",
        "print(\"=\" * 60)\n",
        "print(f\"Epochs: {EPOCHS}\")\n",
        "print(f\"Batch Size: {BATCH_SIZE}\")\n",
        "print(f\"Project: {PROJECT}\")\n",
        "print(f\"Name: {NAME}\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# Train\n",
        "!python scripts/train_stage1.py \\\n",
        "    --data datasets/processed/stage1/data.yaml \\\n",
        "    --epochs {EPOCHS} \\\n",
        "    --batch-size {BATCH_SIZE} \\\n",
        "    --device 0 \\\n",
        "    --name {NAME} \\\n",
        "    --project {PROJECT}\n",
        "\n",
        "print(\"\\n✅ Training complete!\")"
      ],
      "metadata": {
        "id": "train"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Step 5: Export Model"
      ],
      "metadata": {
        "id": "step5"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from ultralytics import YOLO\n",
        "import os\n",
        "\n",
        "# Load best model\n",
        "model_path = f\"{PROJECT}/{NAME}/weights/best.pt\"\n",
        "print(f\"Loading model from: {model_path}\")\n",
        "model = YOLO(model_path)\n",
        "\n",
        "# Export to ONNX\n",
        "print(\"\\nExporting to ONNX...\")\n",
        "onnx_path = model.export(format='onnx', opset=17)\n",
        "print(f\"✓ ONNX exported: {onnx_path}\")\n",
        "\n",
        "# Export to CoreML\n",
        "print(\"\\nExporting to CoreML...\")\n",
        "coreml_path = model.export(format='coreml', precision='fp16')\n",
        "print(f\"✓ CoreML exported: {coreml_path}\")\n",
        "\n",
        "# List exported files\n",
        "print(\"\\nExported models:\")\n",
        "!ls -lh {PROJECT}/{NAME}/weights/"
      ],
      "metadata": {
        "id": "export"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "source": [
        "## Step 6: Download Models"
      ],
      "metadata": {
        "id": "step6"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "# Download models to your computer\n",
        "from google.colab import files\n",
        "\n",
        "print(\"Downloading ONNX model...\")\n",
        "files.download(f\"{PROJECT}/{NAME}/weights/best.onnx\")\n",
        "\n",
        "print(\"\\nDownloading CoreML model...\")\n",
        "files.download(f\"{PROJECT}/{NAME}/weights/best_coreml.mlpackage\")\n",
        "\n",
        "print(\"\\n✅ Download complete!\")"
      ],
      "metadata": {
        "id": "download"
      },
